# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ydeck

# AI Services
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Instagram Graph API
INSTAGRAM_PAGE_ACCESS_TOKEN=your_instagram_page_access_token_here
INSTAGRAM_VERIFY_TOKEN=your_instagram_verify_token_here
# App secret from the Meta App dashboard, used to verify X-Hub-Signature-256
# on incoming Instagram webhook deliveries. Required in production — the
# webhook route rejects all POSTs (401) if this is unset.
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# Supabase (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
